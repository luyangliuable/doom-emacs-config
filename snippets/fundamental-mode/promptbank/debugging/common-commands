Common debugging commands:

# Check logs
tail -f /var/log/application.log
aws logs tail /ecs/${1:log-group-name} --follow

# Check process status
ps aux | grep ${2:process-name}
systemctl status ${3:service-name}

# Network debugging
netstat -tuln | grep ${4:port}
curl -v ${5:http://localhost:port/health}

# Container debugging
docker ps
docker logs ${6:container-id}
docker exec -it ${6} sh

# Database debugging
psql -h ${7:host} -U ${8:user} -d ${9:database}
SELECT * FROM pg_stat_activity;

# Check environment variables
env | grep ${10:VAR_NAME}
printenv

# Memory/CPU usage
top
htop
free -h
$0
